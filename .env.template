PORT=

# Web UI: WEB_UI_ENABLED=false starts the bot headless (only /metrics).
# WEB_AUTH_TOKEN empty = no login. Then the UI accepts only requests to localhost/127.0.0.1.
# Set WEB_AUTH_TOKEN to use the UI via another host name or IP.
# Never expose the UI to the internet without an HTTPS reverse proxy.
# Basic auth sends the token in plain text.
WEB_UI_ENABLED=true
WEB_HOST=127.0.0.1
WEB_AUTH_TOKEN=

