PORT=

# Web UI: WEB_UI_ENABLED=false starts the bot headless (only /metrics).
# WEB_AUTH_TOKEN empty = no login. Then the UI accepts only requests to localhost/127.0.0.1.
# Set WEB_AUTH_TOKEN to use the UI via another host name or IP.
# Never expose the UI to the internet without an HTTPS reverse proxy.
# Without HTTPS the password and the session cookie travel in plain text.
WEB_UI_ENABLED=true
WEB_HOST=127.0.0.1
WEB_AUTH_TOKEN=

STEAM_USERNAME=
STEAM_PASSWORD=
STEAM_SHARED_SECRET=
STEAM_IDENTITY_SECRET=
STEAM_API_KEY=
STEAM_MAIN_ACCOUNT=
DISCORD_WEBHOOK_ID=
DISCORD_WEBHOOK_TOKEN=
UPTIMEKUMA_URL=
UPTIMEKUMA_KEY=
PROMETHEUS_PREFIX=

# Comma-separated App IDs (e.g. 123,456,789). Leave empty if not needed.
# Sale cards the bot gives. For 1 sale card it must get 3 cards of other games. Same-set swaps are allowed.
SALE_CARDS_GIVE_1_FOR_3_APP_IDS=
# Sale card the bot collects (one App ID). For 1 sale card it gives 2 cards of other games.
SALE_CARD_GET_1_FOR_2_APP_ID=

# Set rules. A game can be in more than one list (see README, "Set rules").
# Trade kinds: swap = same-set swap (1:1, 2:2, ...), give = give 1 for 2 cards of other games,
# get = get the card in a cross-set trade.
# Cross-set trades count all cross-set cards together: for each given card the bot gets at least 2 (any games).
# No ONLY_* list: all kinds allowed. With ONLY_* lists: only their kinds. NEVER_* and BLOCKED then remove kinds.
# Bot never gives and never gets cards of these games.
BLOCKED_APP_IDS=
# Bot never gives cards of these games (removes swap and give).
NEVER_GIVE_APP_IDS=
# Bot never gets cards of these games (removes swap and get).
NEVER_GET_APP_IDS=
# Allows same-set swaps.
ONLY_SAME_SET_SWAP_APP_IDS=
# Allows to give these cards for 2 cards of other games.
ONLY_GIVE_1_FOR_2_APP_IDS=
# Allows to get these cards in cross-set trades. The other received cards can be of any game.
ONLY_GET_CROSS_SET_APP_IDS=
# Bot gives these cards only if it keeps at least 1 copy of each.
GIVE_ONLY_DUPLICATES_APP_IDS=

# true = decline clear cases automatically: bot gives a non-card item, a card it never gives,
# or only last copies of protected cards in an N:N offer (1:1, 2:2, ...). Other cases stay open for a manual check.
AUTO_DECLINE_CLEAR_CASES=false
# SteamID64s whose chat messages are not forwarded.
IGNORE_MESSAGES_FROM=
