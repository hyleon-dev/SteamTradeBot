PORT=

# Web UI: WEB_UI_ENABLED=false starts the bot headless (only /metrics).
# WEB_AUTH_TOKEN empty = no login. Then the UI accepts only requests to localhost/127.0.0.1.
# Set WEB_AUTH_TOKEN to use the UI via another host name or IP.
# Never expose the UI to the internet without an HTTPS reverse proxy.
# Basic auth sends the token in plain text.
WEB_UI_ENABLED=true
WEB_HOST=127.0.0.1
WEB_AUTH_TOKEN=

STEAM_USERNAME=
STEAM_PASSWORD=
STEAM_SHARED_SECRET=
STEAM_IDENTITY_SECRET=
STEAM_API_KEY=
STEAM_MAIN_ACCOUNT=
DISCORD_WEBHOOK_ID=
DISCORD_WEBHOOK_TOKEN=
UPTIMEKUMA_URL=
UPTIMEKUMA_KEY=
PROMETHEUS_PREFIX=

# Comma-separated App IDs (e.g. 123,456,789). Leave empty if not needed.
# Sale cards the bot gives. For 1 sale card it must get 3 cards.
SALE_CARDS_GIVE_1_FOR_3_APP_IDS=
# Sale card the bot collects (one App ID). For 1 sale card it gives 2 cards.
SALE_CARD_GET_1_FOR_2_APP_ID=
# Bot never gives cards of these games.
NEVER_GIVE_APP_IDS=
# Bot never gets cards of these games.
NEVER_GET_APP_IDS=
# Bot gives cards of these games only 1:1 for cards of the same set, and only duplicates.
GIVE_ONLY_SAME_SET_DUPLICATES_APP_IDS=
# Bot gets cards of these games only 1:1 for cards of the same set.
GET_ONLY_SAME_SET_APP_IDS=
# true = decline clear cases automatically: bot gives a non-card item, a NEVER_GIVE card,
# or only last copies of protected cards in an N:N offer (1:1, 2:2, ...). Other cases stay open for a manual check.
AUTO_DECLINE_CLEAR_CASES=false
# SteamID64s whose chat messages are not forwarded.
IGNORE_MESSAGES_FROM=
